# LAMS Backend Environment Configuration Template
APP_NAME="National Land Acquisition & Management System"
APP_ENV=development
DEBUG=true
API_PREFIX=/api

# Database Configuration (PostgreSQL + AsyncPG)
DATABASE_URL=postgresql+asyncpg://lams_user:lams_password@localhost:5432/lams_db

# Security & JWT Token Configuration
JWT_SECRET_KEY=change_me_to_a_random_32_byte_hex_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Development Seed Admin Account (Change in deployment)
SEED_ADMIN_EMAIL=admin.national@lams.gov.in
SEED_ADMIN_PASSWORD=SetSecureDevPassword2026!

# CORS Configuration (JSON array or comma-separated URLs)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
