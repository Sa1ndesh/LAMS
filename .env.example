# =====================================================================
# National Land Acquisition & Management System (LAMS)
# Environment Configuration Template (.env.example)
# =====================================================================

# Application Environment
APPLICATION_ENV=production
LOG_LEVEL=INFO
DEBUG=false
APP_NAME="National Land Acquisition & Management System"
APP_SHORT_NAME="LAMS"
VERSION="1.0.0"

# Database Configuration (PostgreSQL 18 + PostGIS 3.6)
POSTGRES_DB=lams
POSTGRES_USER=lams_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_SECURE_STRONG_PASSWORD_IN_PRODUCTION
POSTGRES_HOST=database
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://lams_user:CHANGE_THIS_TO_A_SECURE_STRONG_PASSWORD_IN_PRODUCTION@database:5432/lams

# Security & JWT Configuration
# Generate secure secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_KEY_32_BYTES_MIN
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Production Seed Credentials (Development & Demo Only)
SEED_ADMIN_EMAIL=admin.national@lams.gov.in
SEED_ADMIN_PASSWORD=LamsAdmin@2026

# Production CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=https://lams.gov.in,http://localhost:5173,http://localhost:3000

# Persistent Document Storage Location
LAMS_STORAGE_PATH=/app/storage

# Frontend Public API URL (Used during Vite build)
VITE_API_BASE_URL=http://localhost:8000

